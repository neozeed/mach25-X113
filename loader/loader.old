typedef unsigned char  uint8_t;
typedef unsigned short uint16_t;
typedef unsigned long  uint32_t;

/* ------------------------------------------------------------------ */
/*  VGA DEBUG OUTPUT                                                   */
/* ------------------------------------------------------------------ */

#define VGA ((uint16_t *)0xB8000)
static int vga_pos = 0;

static void vga_putc(char c)
{
    if (c == '\n') {
        vga_pos = (vga_pos / 80 + 1) * 80;
        return;
    }
    VGA[vga_pos++] = (uint16_t)((0x07 << 8) | (unsigned char)c);
}

static void vga_print(const char *s)
{
    while (*s)
        vga_putc(*s++);
}

static void vga_hex(uint32_t v)
{
    const char *h = "0123456789ABCDEF";
    int i;
    for (i = 28; i >= 0; i -= 4)
        vga_putc(h[(v >> i) & 0xF]);
}

static void vga_clear(void)
{
    int i;
    for (i = 0; i < 80 * 25; i++)
        VGA[i] = (uint16_t)((0x07 << 8) | ' ');
    vga_pos = 0;
}

/* ------------------------------------------------------------------ */
/*  MULTIBOOT STRUCTS                                                  */
/* ------------------------------------------------------------------ */

struct multiboot_module {
    uint32_t mod_start;
    uint32_t mod_end;
    uint32_t string;
    uint32_t reserved;
};

struct multiboot_info {
    uint32_t flags;
    uint32_t mem_lower, mem_upper;
    uint32_t boot_device;
    uint32_t cmdline;
    uint32_t mods_count;
    uint32_t mods_addr;
};

/* ------------------------------------------------------------------ */
/*  ELF STRUCTS                                                        */
/* ------------------------------------------------------------------ */

typedef struct {
    uint8_t  e_ident[16];
    uint16_t e_type;
    uint16_t e_machine;
    uint32_t e_version;
    uint32_t e_entry;
    uint32_t e_phoff;
    uint32_t e_shoff;
    uint32_t e_flags;
    uint16_t e_ehsize;
    uint16_t e_phentsize;
    uint16_t e_phnum;
    uint16_t e_shentsize;
    uint16_t e_shnum;
    uint16_t e_shstrndx;
} Elf32_Ehdr;

typedef struct {
    uint32_t p_type;
    uint32_t p_offset;
    uint32_t p_vaddr;
    uint32_t p_paddr;
    uint32_t p_filesz;
    uint32_t p_memsz;
    uint32_t p_flags;
    uint32_t p_align;
} Elf32_Phdr;

#define PT_LOAD        1
#define KERN_VIRT_BASE 0xC0000000UL

/* ------------------------------------------------------------------ */
/*  SAFE MEMMOVE‑STYLE COPY                                            */
/* ------------------------------------------------------------------ */

static void memcpy_safe(void *dst, const void *src, uint32_t len)
{
    uint8_t *d;
    const uint8_t *s;

    d = (uint8_t *)dst;
    s = (const uint8_t *)src;

    if (d == s || len == 0)
        return;

    if (d < s) {
        while (len--)
            *d++ = *s++;
    } else {
        d += len;
        s += len;
        while (len--)
            *--d = *--s;
    }
}

/* ------------------------------------------------------------------ */
/*  LOADER MAIN                                                        */
/* ------------------------------------------------------------------ */

void loader_main(uint32_t magic, struct multiboot_info *mbi)
{
    struct multiboot_module *mods;
    uint32_t mod_start;
    Elf32_Ehdr eh;
    Elf32_Phdr ph[8];
    uint32_t i;
    uint32_t seg_v;
    uint32_t seg_p;
    uint32_t entry_phys;
    void (*entry)(void);

    vga_clear();
    vga_print("Loader: entered loader_main()\n");

    if (magic != 0x2BADB002UL) {
        vga_print("Bad multiboot magic\n");
        for (;;)
            ;
    }

    if (!(mbi->flags & (1UL << 3)) || mbi->mods_count == 0) {
        vga_print("No module\n");
        for (;;)
            ;
    }

    mods = (struct multiboot_module *)mbi->mods_addr;
    mod_start = mods[0].mod_start;

    vga_print("mod_start=");
    vga_hex(mod_start);
    vga_putc('\n');

    /* Copy ELF header and program headers out of the module */
    memcpy_safe(&eh, (void *)mod_start, (uint32_t)sizeof(eh));
    memcpy_safe(ph,
                (void *)(mod_start + eh.e_phoff),
                (uint32_t)(eh.e_phnum * (uint32_t)sizeof(Elf32_Phdr)));

    /* Load PT_LOAD segments */
    for (i = 0; i < eh.e_phnum; i++) {
        uint8_t *src;
        uint8_t *dst;
        uint32_t j;

        if (ph[i].p_type != PT_LOAD)
            continue;

        src = (uint8_t *)mod_start + ph[i].p_offset;

        if (ph[i].p_paddr < KERN_VIRT_BASE)
            dst = (uint8_t *)ph[i].p_paddr;
        else
            dst = (uint8_t *)(ph[i].p_vaddr - KERN_VIRT_BASE);

        vga_print("LOAD dst=");
        vga_hex((uint32_t)dst);
        vga_print(" src=");
        vga_hex((uint32_t)src);
        vga_print(" size=");
        vga_hex(ph[i].p_filesz);
        vga_putc('\n');

        memcpy_safe(dst, src, ph[i].p_filesz);

        /* zero BSS */
        for (j = ph[i].p_filesz; j < ph[i].p_memsz; j++)
            dst[j] = 0;
    }

    /* Compute physical entry from first PT_LOAD */
    seg_v = 0;
    seg_p = 0;
    for (i = 0; i < eh.e_phnum; i++) {
        if (ph[i].p_type == PT_LOAD) {
            seg_v = ph[i].p_vaddr;
            if (ph[i].p_paddr < KERN_VIRT_BASE)
                seg_p = ph[i].p_paddr;
            else
                seg_p = ph[i].p_vaddr - KERN_VIRT_BASE;
            break;
        }
    }

    entry_phys = seg_p + (eh.e_entry - seg_v);

    vga_print("Entry virt=");
    vga_hex(eh.e_entry);
    vga_print(" phys=");
    vga_hex(entry_phys);
    vga_putc('\n');

    __asm__ __volatile__("cli");

    entry = (void (*)(void))entry_phys;
    entry();

    vga_print("Returned from kernel?!\n");
    for (;;)
        ;
}
